{
  "name": "minty",
  "displayName": "Minty",
  "description": "A calm, minimal dark theme built around eucalyptus green.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "minimal",
    "green",
    "eucalyptus"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Minty",
        "uiTheme": "vs-dark",
        "path": "./themes/minty-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-contrast.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-rewrite-relative-links"
  }
}
